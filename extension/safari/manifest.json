{
  "manifest_version": 2,
  "name": "Safari Agent Bridge",
  "version": "0.1.0",
  "description": "Bridges your real Safari profile to a local MCP server for AI agent control.",
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "17.0"
    }
  },
  "background": {
    "scripts": ["dist/background.js"],
    "persistent": true
  },
  "permissions": ["tabs", "scripting", "activeTab", "alarms", "storage", "webRequest", "<all_urls>"],
  "options_page": "options.html",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg",
    "128": "icon.svg",
    "512": "icon.svg"
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*"
}
